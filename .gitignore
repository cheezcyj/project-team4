# 팀원 PC에서 설치하거나 생성하는 파일
/node_modules/
/.next/
*.tsbuildinfo

# 팀원별 시연 데이터와 자동 검사 결과
/.local/

# 개인 환경설정은 제외하고 비어 있는 예시만 공유
.env*
!/.env.example

# Local Python data-preparation environment and generated bytecode
/.venv/
__pycache__/
*.py[codz]

# Local source datasets, extracted files, and generated metadata
/data/

# Local research snapshots, validation logs, and inspection images
/.tmp/research/

# Local downloads and download utility
/physionet.org/
/wget.exe
/.wget-hsts
