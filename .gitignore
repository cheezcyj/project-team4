# PC에서 설치하거나 생성하는 파일
/node_modules/
/.next/
/.next-local-check/
*.tsbuildinfo

# 로컬 모델 연결 설정·인증 값·캐시·대화 데이터·검사 결과
/.local/

# 개인 환경설정은 제외하고 비어 있는 예시만 공유
.env*
!/.env.example

# Python 데이터 준비 환경과 생성된 바이트 코드
/.venv/
__pycache__/
*.py[codz]

# 원본 데이터·압축 해제 결과·생성 메타데이터
/data/

# 로컬 자료 수집 스냅샷·로그·확인 이미지
/.tmp/research/

# 로컬 다운로드와 다운로드 도구
/physionet.org/
/wget.exe
/.wget-hsts
