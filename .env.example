# Copy to .env.local only to save your own settings. Never add a service-role key.
# Local demonstration uses npm run dev:demo and does not need these values.
APP_MODE=supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional local assistant. Basic demo commands do not download or start a model.
# Compatible endpoint: POST /v1/chat/completions; only loopback hosts are allowed.
ASSISTANT_ENABLED=0
ASSISTANT_MODEL_BASE_URL=http://127.0.0.1:11434/v1
ASSISTANT_MODEL=
ASSISTANT_MODEL_API_KEY=
ASSISTANT_MODEL_TIMEOUT_MS=90000
# Optional assistant:model launcher: set your own existing executable/GGUF paths.
# Keep downloaded files under .local/ or outside the repository. Never share real paths.
LLAMA_SERVER_PATH=
ASSISTANT_GGUF_PATH=
# Ollama: register a local model and use its exact name (see docs/ASSISTANT_OLLAMA.md).
# text was verified with the imported Gemma model. JSON/source validation always applies.
ASSISTANT_MODEL_RESPONSE_FORMAT=text
# 0: public MedlinePlus health-topic summaries, with internet access and no API key.
# 1: existing team draft corpus, for explicit local experiments only.
# Draft preview is normally for APP_MODE=demo. Restricted Supabase evaluation
# additionally requires development, loopback requests, current consent, and
# an allowlisted synthetic account whose email ends in .invalid.
# Enabling this does not approve the source materials for publication.
ASSISTANT_ALLOW_DRAFT_PREVIEW=0
# Set 0 only for isolated draft evaluation without public-source fallback.
ASSISTANT_PUBLIC_SOURCES_ENABLED=1
# Server-only UUID list for a separate local evaluation app. Leave empty normally.
# Ignored in production; never add real user accounts.
ASSISTANT_SUPABASE_EVAL_USER_IDS=
